{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Memplex 记忆循环：Recall → 回合 → Capture",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "output": "memplex-memory-loop.html",
    "views": [
      {
        "id": "read-path",
        "label": "读路径",
        "focus": [
          "turn-start",
          "authz",
          "multipath",
          "rerank",
          "inject",
          "reply"
        ],
        "note": "回合前 recall：全局预算分给 RAG/wiki/graph，六维重排后裁剪注入。"
      },
      {
        "id": "write-path",
        "label": "写路径与后台",
        "focus": [
          "reply",
          "capture",
          "extract",
          "persist",
          "worker",
          "observe"
        ],
        "note": "回合后 capture：身份绑定先于持久化；后台任务尽力而为。"
      }
    ]
  },
  "lanes": [
    {
      "id": "host",
      "label": "宿主会话"
    },
    {
      "id": "read",
      "label": "读路径 · Recall"
    },
    {
      "id": "write",
      "label": "写路径 · Capture"
    },
    {
      "id": "bg",
      "label": "后台与旁路",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "recall-phase",
      "label": "Recall（回合前）",
      "fromCol": 0,
      "toCol": 2
    },
    {
      "id": "turn-phase",
      "label": "回复与采集",
      "fromCol": 3,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "capture-phase",
      "label": "落库（写事务）",
      "fromCol": 4,
      "toCol": 5
    }
  ],
  "groups": [
    {
      "id": "write-txn",
      "label": "写事务",
      "lane": "write",
      "fromCol": 3,
      "toCol": 5
    },
    {
      "id": "best-effort",
      "label": "尽力而为（不在写事务内）",
      "lane": "bg",
      "fromCol": 4,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "turn-start",
    "authz",
    "multipath",
    "rerank",
    "inject",
    "reply",
    "capture",
    "extract",
    "persist"
